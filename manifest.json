{
  "id": "de.bennowo.asyar-zed",
  "name": "Zed",
  "version": "1.0.0",
  "description": "Open recent Zed projects and selected files in Zed.",
  "author": "bennowo",
  "icon": "icon.png",
  "type": "extension",
  "searchable": true,
  "background": {
    "main": "dist/worker.js"
  },
  "asyarSdk": "^4.19.0",
  "platforms": [
    "macos",
    "linux",
    "windows"
  ],
  "permissions": [
    "shell:spawn",
    "notifications:send",
    "selection:read",
    "files:read",
    "fs:read",
    "cache:read",
    "cache:write"
  ],
  "permissionArgs": {
    "shell:spawn": [
      "/usr/bin/osascript",
      "/bin/sh",
      "powershell.exe"
    ],
    "files:read": [
      "**/.git/HEAD"
    ]
  },
  "commands": [
    {
      "id": "open-recent",
      "name": "Open Recent Zed Project",
      "description": "Pick a recent Zed project and open it",
      "mode": "view",
      "component": "RecentsView"
    },
    {
      "id": "open-finder-folder",
      "name": "Open with Zed",
      "description": "Open the selected file manager items in Zed",
      "mode": "background"
    }
  ]
}
